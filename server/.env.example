# ── Required ──────────────────────────────────────────────
# Supabase project URL (Settings > API > Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service-role key — server-side only, NEVER expose to the browser.
# Find it: Supabase Dashboard > Settings > API > service_role (secret)
#
# In deployment environments, inject via:
#   - Platform env vars (Render, Railway, Fly.io, Vercel)
#   - Docker secrets / docker-compose env_file
#   - CI/CD pipeline secrets (GitHub Actions, etc.)
#
# Do NOT commit real values. This file is a template only.
# Legacy server-side key. Keep this for existing deployments.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Modern server-side key (use this instead of SUPABASE_SERVICE_ROLE_KEY when available).
# SUPABASE_SECRET_KEY=your-secret-key-here

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origin(s). Set to the EXACT production
# frontend origin(s). NEVER ship '*' in production.
#   Production: https://intake.mthryve.com
#   Staging:    https://staging-intake.mthryve.com
#   Local dev:  http://localhost:8443 (or '*' for local testing only)
# If '*' is set, every origin is allowed — this must be a development-only value.
ALLOWED_ORIGINS=*

# Internal service key (scanner, background jobs). Minimum 32 characters.
# Never expose in the frontend bundle.
API_INTERNAL_KEY=replace-with-a-random-key-at-least-32-characters

# ── Optional ──────────────────────────────────────────────
# Anon/public key for JWT verification and client-scoped RLS operations.
SUPABASE_ANON_KEY=your-anon-key-here

# Server port (default: 3000)
PORT=3000

# Environment: development | test | staging | production
NODE_ENV=development

# Local-only convenience for the unauthenticated internal intake SPA.
# Must remain false in staging/production; production uses Supabase JWT auth.
DEV_AUTH_BYPASS=false

# Supabase Storage bucket for client assets (default: intake-assets)
SUPABASE_STORAGE_BUCKET=intake-assets

# Maximum upload file size in MB (default: 25)
MAX_UPLOAD_SIZE_MB=25

# ── Secret Rotation ──────────────────────────────────────
# To rotate SUPABASE_SERVICE_ROLE_KEY:
#   1. Generate a new key in Supabase Dashboard > Settings > API
#   2. Update the env var in your deployment platform
#   3. Restart/redeploy the server
#   4. The old key is invalidated automatically by Supabase
#   5. No code changes required — the server reads the key at startup

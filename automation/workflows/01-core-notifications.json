{
  "name": "Intake – Core Notifications",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-webhook",
      "name": "Supabase Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "intake-outbox-insert",
      "notes": "Receives INSERT events from Supabase notification_outbox DB webhook"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "email", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.channel }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "email" }] } },
            { "outputKey": "slack", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.channel }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "slack" }] } }
          ]
        }
      },
      "id": "route-by-channel",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "intake_submitted", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.event_type }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "intake_submitted" }] } },
            { "outputKey": "build_card_generated", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.event_type }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "build_card_generated" }] } },
            { "outputKey": "owner_decision", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.event_type }}", "operator": { "type": "string", "operation": "startsWith" }, "rightValue": "owner_" }] } },
            { "outputKey": "finance", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.event_type }}", "operator": { "type": "string", "operation": "contains" }, "rightValue": "finance" }] } },
            { "outputKey": "build", "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.record.event_type }}", "operator": { "type": "string", "operation": "startsWith" }, "rightValue": "build_" }] } }
          ]
        }
      },
      "id": "route-email-by-event",
      "name": "Route Email by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [750, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.record.recipient_ref }}",
        "subject": "=New Intake Submitted – {{ $json.record.payload.reference }}",
        "message": "=A new intake has been submitted.\n\nReference: {{ $json.record.payload.reference }}\nCompany: {{ $json.record.payload.company }}\nTier: {{ $json.record.payload.tier }}\nPreliminary Value: {{ $json.record.payload.preliminary_value }}\n\nReview it in the console."
      },
      "id": "email-intake-submitted",
      "name": "Email – Intake Submitted",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1000, 100],
      "credentials": { "gmailOAuth2": { "id": "gmail-notifications", "name": "Gmail Notifications" } }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.INTAKE_API_BASE }}/api/internal/outbox/{{ $json.record.id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.API_INTERNAL_KEY }}" }] },
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "status", "value": "delivered" }] }
      },
      "id": "mark-delivered",
      "name": "Mark Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.INTAKE_API_BASE }}/api/internal/outbox/{{ $json.record.id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.API_INTERNAL_KEY }}" }] },
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "status", "value": "failed" }, { "name": "last_error", "value": "={{ $json.error.message }}" }] }
      },
      "id": "mark-failed",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "channel": "#intake-notifications",
        "text": "=:bell: *{{ $json.record.event_type }}*\nRef: {{ $json.record.payload.reference }}\n{{ $json.record.payload.summary || '' }}"
      },
      "id": "slack-notify",
      "name": "Slack Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [750, 450],
      "credentials": { "slackOAuth2Api": { "id": "slack-ops", "name": "Slack Ops" } }
    }
  ],
  "connections": {
    "Supabase Webhook Trigger": { "main": [[{ "node": "Route by Channel", "type": "main", "index": 0 }]] },
    "Route by Channel": {
      "main": [
        [{ "node": "Route Email by Event Type", "type": "main", "index": 0 }],
        [{ "node": "Slack Notification", "type": "main", "index": 0 }]
      ]
    },
    "Route Email by Event Type": {
      "main": [
        [{ "node": "Email – Intake Submitted", "type": "main", "index": 0 }],
        [{ "node": "Mark Delivered", "type": "main", "index": 0 }],
        [{ "node": "Mark Delivered", "type": "main", "index": 0 }],
        [{ "node": "Mark Delivered", "type": "main", "index": 0 }],
        [{ "node": "Mark Delivered", "type": "main", "index": 0 }]
      ]
    },
    "Email – Intake Submitted": { "main": [[{ "node": "Mark Delivered", "type": "main", "index": 0 }]] },
    "Slack Notification": { "main": [[{ "node": "Mark Delivered", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": ""
  },
  "meta": {
    "phase": "11",
    "version": "1.0.0"
  }
}
